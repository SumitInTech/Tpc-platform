# Server Environment Variables
PORT=5000
MONGODB_URI=mongodb://localhost:27017/tpc-flow
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
BCRYPT_ROUNDS=12
# Comma-separated institute email domains permitted for student self-signup.
# Leave empty to allow any domain (dev only). Example: tpcflow.local,college.edu.in
ALLOWED_EMAIL_DOMAINS=tpcflow.local
